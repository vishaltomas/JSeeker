{
  "manifest_version": 3,
  "name": "JSeeker Autofill",
  "version": "2.1.0",
  "description": "Fill job application forms in your browser using your JSeeker profile and resume, and ask JSeeker about the page you're on.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8743/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fill this form with JSeeker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-chat": {
      "suggested_key": { "default": "Alt+J" },
      "description": "Open the JSeeker chat panel on this page"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "manifest_version": 3,
  "name": "JSeeker Autofill",
  "version": "2.0.0",
  "description": "Fill job application forms in your browser using your JSeeker profile and resume.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8743/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fill this form with JSeeker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

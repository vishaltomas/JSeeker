{
  "manifest_version": 3,
  "name": "JSeeker Chat",
  "version": "3.0.0",
  "description": "A floating chat panel on any page, backed by your JSeeker profile and resume — ask about the posting you're on and draft answers to its questions.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8743/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ask JSeeker about this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-chat": {
      "suggested_key": { "default": "Alt+J" },
      "description": "Open the JSeeker chat panel on this page"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
